{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Minderal",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4020",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Minderal - Widget OS",
        "width": 1200,
        "visible": true,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "dragDropEnabled": false
      },
      {
        "title": "Mindbar - Search Engine",
        "label": "mindbar",
        "url": "/mindbar",
        "center": true,
        "visible": false,
        "width": 800,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
